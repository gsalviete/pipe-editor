# Compose-mode configuration. Copy to `.env` and edit; values here
# are sensible defaults for a quick demo.

# Host-side directory that the compose stack mounts at /workspace
# inside the backend container. `POST /api/detect` interprets every
# request's `projectPath` relative to this directory (per ADR-0008
# workspace-root containment). Use an absolute path, or a path
# relative to the repo root.
#
# Defaults to `./test/fixtures` so `docker compose up -d` works out
# of the box against the bundled fixtures.
WORKSPACE_HOST_PATH=./test/fixtures

# Host ports the stack publishes on loopback only. Change if 3000
# or 5173 collide with something else on your machine.
# (These are NOT consumed by the backend or frontend directly —
#  edit docker-compose.yml's `ports:` mapping if you change them.)
# BACKEND_HOST_PORT=3000
# FRONTEND_HOST_PORT=5173

# Extra hostnames the backend will answer to, comma-separated.
#
# pipe-editor only answers requests whose Host header names this machine
# (127.0.0.1, localhost, ::1) — the standard defence against a web page on
# another domain pointing its DNS at your loopback and reading your source
# tree through your browser (SEC-01). Set this only if you reach the editor
# by some other name; ports are ignored.
#
# PIPE_EDITOR_ALLOWED_HOSTS=editor.local,my-box.lan
