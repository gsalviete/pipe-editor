# Local-dev configuration for the pipe-editor backend. Copy to `.env`.

# Port the HTTP listener binds. Default: 3000.
PORT=3000

# Bind address. Default 127.0.0.1 (EDITOR-API-NFR-001 — no LAN exposure).
# In a container set 0.0.0.0 and gate exposure at the port mapping
# (see ADR-0009 / docker-compose.yml).
# BIND_ADDRESS=127.0.0.1

# Origin allowed by CORS. Default: http://localhost:5173 (Vite dev server).
FRONTEND_URL=http://localhost:5173

# REQUIRED. Absolute path every /api/detect projectPath is resolved
# against (ADR-0008 workspace-root containment). The backend refuses
# to start when unset or invalid. E.g. the repo root, so the bundled
# fixtures are reachable as test/fixtures/<name>.
PIPE_EDITOR_WORKSPACE_ROOT=/absolute/path/to/workspace

# Optional. Host-facing alias for the same folder when Docker mounts it at a
# different internal path. docker-compose.yml configures this automatically.
# PIPE_EDITOR_WORKSPACE_DISPLAY_ROOT=/absolute/host/path/to/workspace
